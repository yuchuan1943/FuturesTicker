<Window x:Class="FuturesTicker.OptionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="期权详情"
        Icon="app.ico"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="#FFFFFF"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：名称 + 代码 -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" Foreground="#222222" VerticalAlignment="Center"/>
                <TextBlock x:Name="CodeText" FontSize="12" Foreground="#999999" Margin="8,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- 最新价 + 涨跌 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,14">
            <TextBlock x:Name="LastText" FontSize="34" FontWeight="SemiBold" Foreground="#222222" VerticalAlignment="Center"/>
            <TextBlock x:Name="ChangeText" FontSize="14" Margin="12,0,0,6" VerticalAlignment="Bottom"/>
        </StackPanel>

        <!-- 明细网格 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,5,0,5"/>
                </Style>
                <Style x:Key="Lbl" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#999999"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
                <Style x:Key="Val" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </Grid.Resources>

            <!-- 第 1 行：昨结算 / 开盘 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="昨结算"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PrevSettleText" Style="{StaticResource Val}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Lbl}" Text="开盘"/>
            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="OpenText" Style="{StaticResource Val}"/>

            <!-- 第 2 行：最高 / 最低 -->
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="最高"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HighText" Style="{StaticResource Val}" Foreground="#E53935"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Lbl}" Text="最低"/>
            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="LowText" Style="{StaticResource Val}" Foreground="#2E7D32"/>

            <!-- 第 3 行：涨停 / 跌停 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="涨停"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UpperText" Style="{StaticResource Val}" Foreground="#E53935"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Lbl}" Text="跌停"/>
            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="LowerText" Style="{StaticResource Val}" Foreground="#2E7D32"/>

            <!-- 第 4 行：成交量 / 持仓量 -->
            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="成交量"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VolumeText" Style="{StaticResource Val}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Lbl}" Text="持仓量"/>
            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="OiText" Style="{StaticResource Val}"/>

            <!-- 第 5 行：买一价 / 卖一价 -->
            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Lbl}" Text="买一价"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BidText" Style="{StaticResource Val}" Foreground="#2E7D32"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Lbl}" Text="卖一价"/>
            <TextBlock Grid.Row="4" Grid.Column="3" x:Name="AskText" Style="{StaticResource Val}" Foreground="#E53935"/>

            <!-- 第 6 行：买一量 / 卖一量 -->
            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Lbl}" Text="买一量"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="BidVolText" Style="{StaticResource Val}"/>
            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Lbl}" Text="卖一量"/>
            <TextBlock Grid.Row="5" Grid.Column="3" x:Name="AskVolText" Style="{StaticResource Val}"/>

            <!-- 第 7 行：行权价 / 到期月份 -->
            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Lbl}" Text="行权价"/>
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="StrikeText" Style="{StaticResource Val}"/>
            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Lbl}" Text="到期"/>
            <TextBlock Grid.Row="6" Grid.Column="3" x:Name="MonthText" Style="{StaticResource Val}"/>

            <!-- 第 8 行：方向 / 交易所 -->
            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Lbl}" Text="方向"/>
            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DirectionText" Style="{StaticResource Val}"/>
            <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Lbl}" Text="交易所"/>
            <TextBlock Grid.Row="7" Grid.Column="3" x:Name="ExchangeText" Style="{StaticResource Val}"/>
        </Grid>

        <!-- 底部：行情时间 -->
        <TextBlock Grid.Row="3" x:Name="TimeText" FontSize="11" Foreground="#AAAAAA" Margin="0,12,0,0"
                   Text="加载中…"/>
    </Grid>
</Window>
