<Window x:Class="FuturesTicker.MinuteChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分时图"
        Icon="app.ico"
        Width="560" Height="470"
        MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="#FFFFFF"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部信息 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" Foreground="#222222" VerticalAlignment="Center"/>
                <TextBlock x:Name="CodeText" FontSize="12" Foreground="#999999" Margin="8,2,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="LastText" FontSize="16" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ChangeLabel" FontSize="12" Margin="8,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="VolumeInfoText" FontSize="11" Foreground="#777777" Margin="0,5,0,0"
                       Text="成交量 -- 手　　持仓量 -- 手（较开盘 --）"/>
        </StackPanel>

        <!-- 主图区（价格线 + 均价线 + 昨结线） -->
        <Canvas x:Name="Chart" Grid.Row="1" Background="#FBFBFB" ClipToBounds="True"/>

        <!-- 成交量副图 -->
        <Canvas x:Name="VolumeChart" Grid.Row="2" Height="88" Margin="0,6,0,0" Background="#FBFBFB" ClipToBounds="True"/>

        <!-- 底部图例 -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="LegendText" FontSize="10.5" Foreground="#888888"
                       Text="　　—— 价格　　　—— 均价　　　- - 昨结"/>
            <TextBlock x:Name="LoadingText" FontSize="11" Foreground="#999999" Margin="0,3,0,0" Text="加载中…"/>
        </StackPanel>
    </Grid>
</Window>
