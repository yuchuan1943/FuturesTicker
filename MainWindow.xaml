<Window x:Class="FuturesTicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FuturesTicker.Converters"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="期货行情"
        Icon="app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <conv:ChangeBrushConverter x:Key="ChangeBrush"/>

        <!-- 可调字号（代码里由 FontSize 配置动态更新，DynamicResource 会即时刷新）。 -->
        <sys:Double x:Key="NameFontSize">9.5</sys:Double>
        <sys:Double x:Key="PriceFontSize">11</sys:Double>
        <sys:Double x:Key="BadgeFontSize">8.5</sys:Double>

        <!-- 完整模式：品种名 + 最新价 + 涨跌徽章 -->
        <DataTemplate x:Key="FullTemplate">
            <Grid Margin="0,1" ToolTip="{Binding DetailText}" MouseLeftButtonDown="QuoteRow_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="40"/>
                    <ColumnDefinition Width="Auto" MinWidth="44"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ShortName}"
                           FontSize="{DynamicResource NameFontSize}" Foreground="#5A5A5A"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Last, StringFormat={}{0:0.###}}"
                           FontSize="{DynamicResource PriceFontSize}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{Binding Change, Converter={StaticResource ChangeBrush}}"/>

                <Border Grid.Column="2" Margin="6,0,0,0" CornerRadius="3" Padding="3,0"
                        VerticalAlignment="Center"
                        Background="{Binding Change, Converter={StaticResource ChangeBrush}, ConverterParameter=bg}">
                    <TextBlock Text="{Binding ChangeText}" FontSize="{DynamicResource BadgeFontSize}"
                               Foreground="{Binding Change, Converter={StaticResource ChangeBrush}, ConverterParameter=fg}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 极简模式：只显示最新价 -->
        <DataTemplate x:Key="PriceOnlyTemplate">
            <TextBlock Text="{Binding Last, StringFormat={}{0:0.###}}"
                       FontSize="{DynamicResource PriceFontSize}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="1,0"
                       MouseLeftButtonDown="QuoteRow_MouseLeftButtonDown"
                       Foreground="{Binding Change, Converter={StaticResource ChangeBrush}}"/>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#E6FFFFFF"
            BorderBrush="#0F000000"
            BorderThickness="1"
            CornerRadius="8">

        <Grid Margin="7,4,7,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Quote list -->
            <ItemsControl Grid.Row="0" x:Name="QuoteList"/>

            <!-- Subtle status -->
            <TextBlock Grid.Row="1" x:Name="StatusText" Text="连接中…"
                       FontSize="8" Foreground="#B0B0B0"
                       Margin="0,2,0,0" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
